{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "functions": {
    "api/leer.js": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "no-referrer",
        "Permissions-Policy": "camera=(self), microphone=(), geolocation=()",
        "X-Frame-Options": "DENY"
      },
      "continue": true
    },
    {
      "src": "/api/(.*)",
      "headers": {
        "Cache-Control": "no-store"
      },
      "continue": true
    },
    {
      "src": "^/(?!(?:index\\.html|styles\\.css|manifest\\.webmanifest|(?:icon|apple-touch-icon|favicon)[a-z0-9-]*\\.(?:png|svg|ico)|src/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+\\.js|api/leer)?$).*$",
      "status": 404,
      "dest": "/404"
    }
  ]
}
